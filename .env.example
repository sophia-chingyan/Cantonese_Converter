# Copy this file to .env for local runs, or set these as service
# variables in Railway (service -> Variables, or "Raw Editor" to paste
# them all at once). See README.md for where to get each value.

# --- Google OAuth (required) ---
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console.
# Authorized redirect URI: https://<your-railway-domain>/auth/callback
# (Railway shows the domain under Settings -> Networking; it looks like
# <service>-production.up.railway.app unless you attach a custom one.)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The only Google account allowed to sign in.
ALLOWED_EMAIL=you@example.com

# --- Flask (required) ---
# Any long random string. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# --- Translation providers ---
# Poe: create a key at https://poe.com/api/keys (requires an active
# Poe subscription or add-on points - spec D1's locked default).
POE_API_KEY=
POE_MODEL=GPT-5.6-Luna

# Gemini: create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Which provider is pre-selected when the dropdown loads (D1). The
# person can still switch to the other provider per session (R10).
DEFAULT_PROVIDER=poe

# --- File handling ---
# Where saved translations are written. Leave this UNSET on Railway: if a
# volume is attached the app defaults to <volume mount path>/outputs so
# saved files survive redeploys, and without a volume it falls back to the
# container filesystem (files lost on redeploy). Only set it to override.
# OUTPUT_DIR=storage/outputs

# Upload size cap, in MB, for any input file. PDFs are the format
# most likely to need this raised.
MAX_UPLOAD_MB=10

# D2: target chunk size in characters.
CHUNK_SIZE_CHARS=1500

# D3: characters of prior chunk's translation carried forward for style.
CONTEXT_CARRYOVER_CHARS=200

# D6: how many saved files to keep before the oldest are pruned.
FILE_RETENTION_COUNT=50

# --- Networking ---
# Railway injects PORT into the container, so leave this commented out
# there (a hard-coded value would override what Railway routes to).
# Uncomment it only for local runs.
# PORT=8080

# --- Cookies ---
# Marks the session cookie Secure. Defaults to on when running on Railway
# (which is https-only) and off locally (plain http). Only set this to
# override that, e.g. SESSION_COOKIE_SECURE=false when debugging.
# SESSION_COOKIE_SECURE=true
